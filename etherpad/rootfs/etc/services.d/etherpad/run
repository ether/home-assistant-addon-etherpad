#!/usr/bin/with-contenv bashio
# ==============================================================================
# Home Assistant Add-on: Etherpad
# Starts Etherpad as a long-running service under s6-overlay.
# Mirrors the upstream image's CMD (`cd src && node ...`); going through
# `pnpm run prod` triggers pnpm 10's auto-reinstall which aborts in headless
# containers (ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY).
# ==============================================================================
set -e

# Etherpad's settings parser warns on unknown EP_<var> env vars (and EP_DIR
# isn't a setting), so confine its scope to this run script instead of
# exporting it to the whole container env.
EP_DIR=/opt/etherpad-lite

. /etc/etherpad/env

cd "${EP_DIR}/src"

bashio::log.info "Starting Etherpad ${ETHERPAD_VERSION} on port ${PORT}..."
exec node --require tsx/cjs node/server.ts
